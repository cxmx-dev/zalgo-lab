---
import { buildOutput, createSeededRng } from '../lib/zalgo-engine.mjs';

interface Props {
  intensity?: number;
  charBack?: boolean;
  backWords?: boolean;
  terminal?: boolean;
  layerMode?: 'reverse-then-zalgo' | 'zalgo-then-reverse' | 'bleed';
  bleedDecay?: number;
  seed?: number;
  class?: string;
}

const {
  intensity = 3,
  charBack = false,
  backWords = false,
  terminal = false,
  layerMode = 'reverse-then-zalgo',
  bleedDecay = 0.3,
  seed,
  class: className = '',
} = Astro.props;

let sourceText = '';
if (Astro.slots.has('default')) {
  const rendered = await Astro.slots.render('default');
  sourceText = rendered.replace(/<[^>]*>/g, '').trim();
}

const rng = seed != null ? createSeededRng(seed) : (() => Math.random());
const corrupted = buildOutput(sourceText, intensity, {
  charBack,
  backWords,
  terminal,
  layerMode,
  bleedDecay,
  rng,
});

const classes = ['zalgo-output', className, terminal ? 'zalgo-terminal' : '']
  .filter(Boolean)
  .join(' ');
---

<span class={classes} data-zalgo>{corrupted}</span>

<style>
  .zalgo-output {
    display: block;
    font-size: 1.35em;
    line-height: 1.35;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 6px;
  }
  .zalgo-terminal {
    color: #4ade80;
    font-family: ui-monospace, 'Cascadia Code', 'Consolas', monospace;
    text-shadow: 0 0 8px rgba(74, 222, 128, 0.35);
  }
</style>